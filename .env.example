# Copy to .env, which git ignores, and fill in your own values. Make reads it.
# Name your own client and contact; do not reuse another operator's.
# OCM_REGIONS_USER_AGENT = ExampleBot/1.0 (+https://example.org/bot; mailto:bot@example.org)
# OCM_REGIONS_FROM = bot@example.org
# Send requests through your own proxy, and refuse to run without one.
# HTTPS_PROXY = http://proxy.example.org:3128
# HTTP_PROXY = http://proxy.example.org:3128
# NO_PROXY = localhost,127.0.0.1
# OCM_REGIONS_REQUIRE_PROXY = 1
